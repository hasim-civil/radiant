rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      
      // Users can create their own profile during registration
      allow create: if isOwner(userId) && 
                       request.resource.data.keys().hasAll(['name', 'email', 'role']) &&
                       request.resource.data.role in ['admin', 'employee'];
      
      // Users can update their own profile (but not role)
      allow update: if isOwner(userId) && 
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      
      // Admins can read all users
      allow read: if isAdmin();
      
      // Admins can update and delete any user
      allow update, delete: if isAdmin();
    }
    
    // Attendance collection
    match /attendance/{userId}/records/{date} {
      // Users can read their own attendance
      allow read: if isOwner(userId);
      
      // Users can create their own attendance (check-in)
      allow create: if isOwner(userId) && 
                       request.resource.data.keys().hasAll(['checkIn', 'status', 'date']) &&
                       request.resource.data.status == 'incomplete';
      
      // Users can update their own attendance (check-out)
      allow update: if isOwner(userId) && 
                       request.resource.data.keys().hasAll(['checkOut', 'totalHours', 'status']);
      
      // Admins can read all attendance records
      allow read: if isAdmin();

      // Admins can create/update attendance records too (e.g. Add Past Attendance on behalf of an employee, corrections)
      allow create, update: if isAdmin();
      
      // Prevent deletion of attendance records (audit trail)
      allow delete: if false;
    }

    // Holidays collection (top-level, document ID = YYYY-MM-DD)
    // Every authenticated user needs to read these to know their own status;
    // only admins may add/edit/delete them.
    match /holidays/{date} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Paid Leave requests
    match /paidLeaves/{userId}/records/{date} {
      // Owner can read their own leave requests; admin can read anyone's
      allow read: if isOwner(userId) || isAdmin();

      // Employees can create their own leave request, but only in 'pending' state --
      // they cannot self-approve
      allow create: if isOwner(userId) &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.keys().hasAll(['date', 'status']);

      // Only an admin can approve/reject. An owner may re-submit (pending) after
      // a prior rejection, but cannot set their own status to 'approved'.
      allow update: if (isAdmin() && request.resource.data.status in ['approved', 'rejected']) ||
                       (isOwner(userId) && resource.data.status == 'rejected' &&
                        request.resource.data.status == 'pending');

      // Prevent deletion (audit trail)
      allow delete: if false;
    }
  }
}
